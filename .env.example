# 실제 값을 넣은 .env는 커밋하지 마세요 (.gitignore에서 .env*를 무시합니다).
# Railway에 배포할 때는 이 값들을 프로젝트 설정(Variables)에 그대로 추가하면 됩니다.

# ---------- DB/파일 저장 위치 ----------
# 지정 안 하면 프로젝트 폴더의 ./data를 사용합니다. Railway에서는 볼륨이 마운트된 경로로 맞춰야
# 재배포해도 데이터가 유지됩니다.
# DB_DIR=/app/data

# ---------- 관리자 비밀번호 복구 ----------
# 관리자 비밀번호를 잊었을 때 /api/admin/recover로 재설정하기 위한 복구 코드
# ADMIN_RECOVERY_CODE=

# ---------- 백업 이메일 자동 발송 (선택) ----------
# 매일 최근 DB 백업 파일을 이메일로 보냅니다. 넷 다 설정해야 활성화됩니다.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# BACKUP_EMAIL_TO=

# ---------- 오프사이트 백업 (Cloudflare R2, 선택이지만 권장) ----------
# 서버 볼륨 밖에 DB 백업·첨부파일 원본을 자동으로 복사해둡니다. 넷 다 설정해야 활성화됩니다.
# Cloudflare 대시보드 > R2 > 버킷 생성 > "Manage API Tokens"에서 발급.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ---------- 한전 전력량계 자동조회 (선택) ----------
# KEPCO_PMETER_API_KEY=
